{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "unos-game",
  "buildCommand": "npm -w client run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install",
  "framework": "vite",
  "nodeVersion": "20.x",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

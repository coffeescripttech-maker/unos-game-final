# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated origins allowed by CORS (the dev client)
CORS_ORIGIN=http://localhost:3000

# ── MySQL (production persistence) ──────────────────────────
# Provide EITHER a full DATABASE_URL …
# DATABASE_URL=mysql://user:password@host:port/unos_game
# … OR the individual DB_* values:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=unos_game
DB_USER=root
DB_PASSWORD=
DB_POOL_LIMIT=10

# ── Leaderboard ─────────────────────────────────────────────
LEADERBOARD_PAGE_SIZE=20

# ── Firebase Admin (optional, currently unused) ─────────────
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=